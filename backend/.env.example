PORT=3000
NODE_ENV=production
APP_ORIGIN=https://haukesteinbach.de
CORS_ALLOWED_ORIGINS=https://haukesteinbach.de,http://localhost:8000,http://127.0.0.1:8000
SESSION_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>

# Admin area. Generate both lines with:  npm run admin-password -- "your password"
ADMIN_PASSWORD_HASH=
FORMSPREE_UPLOAD_ENDPOINT=https://formspree.io/f/xgopedgb
NOTIFICATION_EMAIL=<INBOX@HAUKESTEINBACH.DE>
MAIL_FROM_EMAIL=mail@haukesteinbach.de
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SOURCE_DOWNLOAD_LINK_TTL_HOURS=168
# Shop (Stripe). Without these the shop stays off and the pre-order form shows.
# The webhook secret comes from the endpoint you create in the Stripe dashboard
# pointing at https://haukesteinbach.de/api/v1/public/shop/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2. Endpoint is https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=steinbach-filehandoff
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Only the release pages still write here; uploads go to R2.
UPLOAD_DIR=/var/lib/steinbach/uploads
