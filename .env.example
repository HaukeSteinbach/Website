# Which published image to run. Every push to main builds both a :latest
# tag and one named after the commit, so latest is the normal setting and
# needs no maintenance.
#
# Pin a commit SHA only to hold a version deliberately — to go back after a
# bad release, or to keep the server on a known build while main moves on:
# IMAGE_TAG=4f3c2b1a0d9e8f76543210fedcba9876543210ff
IMAGE_TAG=latest
HOST_PORT=3000